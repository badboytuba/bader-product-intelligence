<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="bader_product_intelligence.ContentStudio" owl="1">
 <div t-if="state.contentStudio?.open" class="bpi-studio-backdrop">
  <section class="bpi-studio" t-ref="contentStudioDialog" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="bpi-studio-title" t-on-keydown="onStudioKeydown">
   <header class="bpi-studio__header">
    <div class="bpi-studio__brand"><span class="bpi-studio__spark"><i class="fa fa-magic" aria-hidden="true"/></span><div><small>BADER · CONTENT WORKSPACE</small><h2 id="bpi-studio-title">Nancy AI Studio</h2><p><t t-esc="currentProduct().sku"/> · <t t-esc="currentProduct().name"/></p></div></div>
    <button type="button" class="bpi-studio__close" aria-label="Cerrar Studio y conservar los borradores" title="Cerrar y conservar borradores" t-on-click="closeContentStudio"><i aria-hidden="true" class="fa fa-times"/></button>
   </header>
   <div class="bpi-studio__toolbar">
    <span><i aria-hidden="true" class="fa fa-users"/> Historial compartido · Propuestas privadas</span>
    <div><select aria-label="Conversación" class="bpi-input" t-att-disabled="state.contentStudio.busy || state.contentStudio.loading" t-on-change="studioChooseSession"><option t-if="!state.contentStudio.sessions.length" value="">Conversación del producto</option><option t-foreach="state.contentStudio.sessions" t-as="session" t-key="session.id" t-att-value="session.id" t-att-selected="session.id === state.contentStudio.session?.id" t-esc="session.name || ('Estrategia ' + session.id)"/></select><button class="bpi-button bpi-button--secondary" type="button" t-att-disabled="state.contentStudio.busy || state.contentStudio.loading" t-on-click="() => this.openContentStudio(true)"><i aria-hidden="true" class="fa fa-plus"/> Nueva estrategia</button><button type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.contentStudio.busy || state.contentStudio.loading" t-on-click="studioRefresh" aria-label="Actualizar conversación"><i aria-hidden="true" class="fa fa-refresh"/></button></div>
   </div>
   <div class="bpi-studio__mobile-tabs" role="tablist" aria-label="Área del Studio"><button type="button" role="tab" t-att-aria-selected="state.contentStudio.mobileTab === 'conversation' ? 'true' : 'false'" t-on-click="() => state.contentStudio.mobileTab = 'conversation'">1 · Conversación</button><button type="button" role="tab" t-att-aria-selected="state.contentStudio.mobileTab === 'preview' ? 'true' : 'false'" t-on-click="() => state.contentStudio.mobileTab = 'preview'">2 · Previa y revisión</button></div>
   <p t-if="state.contentStudio.error" class="bpi-studio__error" role="alert"><i aria-hidden="true" class="fa fa-exclamation-circle"/> <t t-esc="state.contentStudio.error"/></p>
   <p t-if="state.contentStudio.notice" class="bpi-studio__notice" role="status" t-esc="state.contentStudio.notice"/>
   <div t-if="state.contentStudio.loading" class="bpi-studio__loading" role="status"><i aria-hidden="true" class="fa fa-spinner fa-spin"/> Abriendo tu espacio de trabajo…<small>Sin generar contenido ni consultar fuentes externas.</small></div>
   <div t-elif="state.contentStudio.session" class="bpi-studio__workspace">
    <section t-att-class="'bpi-studio__conversation ' + (state.contentStudio.mobileTab === 'conversation' ? 'is-mobile-active' : '')" aria-label="Contexto y conversación">
     <details class="bpi-studio__brief" open="open">
      <summary><span><small>01 / DIRECCIÓN EDITORIAL</small><strong>Una estrategia. Tu producto.</strong></span><i aria-hidden="true" class="fa fa-sliders"/></summary>
      <div class="bpi-studio__brief-body">
       <p t-if="state.contentStudio.briefConflict" class="bpi-studio__private-warnings" role="alert">La estrategia compartida cambió. Revisa tus notas y guarda la estrategia para confirmar tu versión, o descarta los cambios locales para recuperar la versión del equipo.</p><label for="bpi-studio-intent">¿Qué debe entender o sentir el comprador?</label><textarea id="bpi-studio-intent" class="bpi-textarea" rows="3" maxlength="6000" placeholder="Explica la intención inicial. Nancy la conservará durante los refinamientos." t-model="state.contentStudio.brief.intent"/>
       <div class="bpi-studio__fields"><label>Objetivo<select class="bpi-input" t-model="state.contentStudio.brief.objective"><option value="consultivo">Consultivo</option><option value="tecnico">Técnico</option><option value="educativo">Educativo</option><option value="comercial">Comercial</option></select></label><label>Tono<input class="bpi-input" maxlength="120" placeholder="Profesional y cercano" t-model="state.contentStudio.brief.tone"/></label></div>
       <label>Públicos del mensaje <small>No modifica la clasificación</small></label><div class="bpi-studio__niches"><label t-foreach="studioNicheOptions()" t-as="niche" t-key="niche.id" t-att-class="state.contentStudio.brief.nicheIds.includes(niche.id) ? 'is-selected' : ''"><input type="checkbox" t-att-checked="state.contentStudio.brief.nicheIds.includes(niche.id)" t-on-change="() => this.studioToggleNiche(niche.id)"/><span t-esc="niche.name"/></label><p t-if="!studioNicheOptions().length">Puedes describir los públicos en la intención inicial.</p></div>
       <div class="bpi-studio__fields"><label>Enfoque de la corta<textarea class="bpi-textarea" rows="2" maxlength="3000" placeholder="Beneficio principal, destinatario, diferencia…" t-model="state.contentStudio.brief.shortFocus"/></label><label>Enfoque de la larga<textarea class="bpi-textarea" rows="2" maxlength="3000" placeholder="Qué explicar, profundidad y organización…" t-model="state.contentStudio.brief.longFocus"/></label></div>
       <p class="bpi-studio__hint"><i aria-hidden="true" class="fa fa-file-text-o"/> Base flexible: <b t-esc="state.contentStudio.session.template?.effective?.name || 'Modelo guardado del producto'"/>. No se altera el modelo global.</p>
       <button type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.contentStudio.busy" t-on-click="studioSaveBrief"><i aria-hidden="true" class="fa fa-check"/> Guardar estrategia</button>
      </div>
     </details>
     <details class="bpi-studio__sources">
      <summary><span><small>02 / INFORMACIÓN DE APOYO</small><strong>Fuentes y datos revisados <span class="bpi-studio__count" t-esc="state.contentStudio.session.sources?.length || 0"/></strong></span><i aria-hidden="true" class="fa fa-paperclip"/></summary>
      <div class="bpi-studio__sources-body">
       <p class="bpi-studio__hint">Identidad y dimensiones: datos Odoo guardados. Los archivos de esta conversación son privados y no aparecen en la tienda.</p>
       <div class="bpi-studio__source-entry"><select class="bpi-input" aria-label="Tipo de fuente" t-model="state.contentStudio.sourceKind"><option value="text">Pegar información</option><option value="url">Enlace público</option></select><input class="bpi-input" aria-label="Nombre de la fuente" maxlength="200" placeholder="Nombre de la fuente / fabricante" t-model="state.contentStudio.sourceName"/><textarea t-if="state.contentStudio.sourceKind === 'text'" rows="4" class="bpi-textarea" maxlength="60000" placeholder="Pega la información investigada. Revisa que corresponda al SKU y modelo." t-model="state.contentStudio.sourceText"/><input t-else="" class="bpi-input" type="url" placeholder="https://…" aria-label="Enlace de la fuente" t-model="state.contentStudio.sourceUrl"/><button type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.contentStudio.busy" t-on-click="studioAddSource"><i aria-hidden="true" class="fa fa-plus"/> Añadir fuente</button><label class="bpi-studio__upload"><i aria-hidden="true" class="fa fa-cloud-upload"/> Adjuntar PDF, DOCX o TXT<input type="file" accept=".pdf,.docx,.txt" t-att-disabled="state.contentStudio.busy" t-on-change="studioUploadSource"/></label><small>Máximo 5 archivos · 10 MiB por archivo · PDF: 50 páginas por archivo / 100 por conversación</small></div>
       <article t-foreach="state.contentStudio.session.sources || []" t-as="source" t-key="source.id" t-att-class="'bpi-studio-source is-' + source.state">
        <header><strong t-esc="source.name"/><span t-esc="studioSourceState(source)"/></header>
        <p t-if="source.warnings?.length" class="bpi-studio__hint" t-esc="source.warnings.join(' · ')"/><ul t-if="source.conflicts?.length" class="bpi-studio__conflicts"><li t-foreach="source.conflicts" t-as="conflict" t-key="conflict_index" t-esc="conflict.message || conflict"/></ul>
        <details t-if="source.text"><summary>Ver texto extraído</summary><p class="bpi-studio-source__text" t-esc="source.text"/></details>
        <div class="bpi-studio-source__facts"><label t-foreach="source.facts || []" t-as="fact" t-key="fact.id"><input type="checkbox" t-att-checked="studioSourceFactChecked(source, fact)" t-att-disabled="state.contentStudio.busy || source.state === 'reviewed'" t-on-change="() => this.studioToggleSourceFact(source, fact)"/><span t-esc="fact.text"/></label></div>
        <div class="bpi-studio-source__actions"><button t-if="studioCanReadSource(source)" type="button" class="bpi-button bpi-button--primary" t-att-disabled="state.contentStudio.busy || studioJobActive() || !state.contentStudio.availability.enabled" t-on-click="() => this.studioProcessSource(source)"><i aria-hidden="true" class="fa fa-magic"/> <t t-esc="source.kind === 'file' ? 'Leer PDF completo con Nancy AI' : 'Analizar fuente con Nancy AI'"/></button><button t-if="source.state === 'pending' &amp;&amp; source.text" type="button" class="bpi-button bpi-button--primary" t-att-disabled="state.contentStudio.busy" t-on-click="() => this.studioReviewSource(source, 'approve')">Confirmar datos seleccionados</button><button t-if="source.state !== 'excluded'" type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.contentStudio.busy" t-on-click="() => this.studioReviewSource(source, 'exclude')">Excluir fuente</button><button t-if="source.state === 'excluded'" type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.contentStudio.busy || studioJobActive()" t-on-click="() => this.studioRemoveSource(source)">Quitar archivo de esta conversación</button></div>
       </article>
      </div>
     </details>
     <div class="bpi-studio__messages" role="log" aria-label="Conversación con Nancy AI" aria-live="polite"><div t-if="!state.contentStudio.session.messages?.length" class="bpi-studio__welcome"><span><i aria-hidden="true" class="fa fa-magic"/></span><h3>De información a una historia clara.</h3><p>Cuéntame qué hace especial a este producto. Añade fuentes, revisa sus datos y construyamos una descripción útil para tus clientes.</p></div><article t-foreach="state.contentStudio.session.messages || []" t-as="message" t-key="message.id" t-att-class="'bpi-studio-message ' + (message.role === 'user' ? 'is-user' : 'is-nancy')"><header><b t-esc="message.role === 'user' ? (message.author || 'Equipo Bader') : 'Nancy AI'"/><small t-esc="message.createdAt || ''"/></header><p t-esc="message.content"/></article></div>
     <aside t-if="!state.contentStudio.availability.enabled" class="bpi-studio__availability"><i aria-hidden="true" class="fa fa-info-circle"/><p t-esc="state.contentStudio.availability.reason || 'Verifica la disponibilidad de Nancy AI antes de generar.'"/><button type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.contentStudio.busy" t-on-click="studioActivate">Verificar disponibilidad de Nancy AI</button></aside>
     <div class="bpi-studio__composer"><p t-if="studioJobActive()" role="status"><i aria-hidden="true" class="fa fa-spinner fa-spin"/> <t t-esc="state.contentStudio.session.job?.state === 'pending' ? 'Trabajo en espera' : 'Nancy AI está trabajando'"/> · Puedes cerrar y regresar</p><p t-if="state.contentStudio.session.job?.state === 'failed'" role="alert">Nancy AI no pudo completar el trabajo. Revisa el contexto antes de solicitar otro; no se repetirá automáticamente.</p><textarea class="bpi-textarea" rows="3" maxlength="12000" placeholder="Pide una propuesta o explica qué mejorar…" aria-label="Mensaje para Nancy AI" t-model="state.contentStudio.input" t-on-keydown="onStudioMessageKeydown"/><footer><small>Ctrl / ⌘ + Enter · Solo al enviar se solicita generación</small><button type="button" class="bpi-button bpi-button--primary" t-att-disabled="!studioCanGenerate()" t-on-click="studioSend"><i aria-hidden="true" class="fa fa-arrow-up"/> <t t-esc="state.contentStudio.proposalId ? 'Refinar propuesta' : 'Generar propuesta'"/></button></footer><small t-if="!studioCanGenerate() &amp;&amp; state.contentStudio.availability.enabled &amp;&amp; !studioJobActive()">Revisa o excluye las fuentes pendientes antes de generar.</small></div>
    </section>
    <section t-att-class="'bpi-studio__preview ' + (state.contentStudio.mobileTab === 'preview' ? 'is-mobile-active' : '')" aria-label="Previa de contenido">
     <header class="bpi-studio__preview-head"><div><small>03 / REVISIÓN EDITORIAL</small><h3>Tu próxima descripción.</h3><p>Revisa, edita y elige qué llevar a la ficha.</p></div><select class="bpi-input" aria-label="Versión de propuesta" t-on-change="(ev) => this.studioSelectProposal(ev.target.value)"><option t-if="!state.contentStudio.session.proposals?.length" value="">Sin propuestas</option><option t-foreach="state.contentStudio.session.proposals || []" t-as="proposal" t-key="proposal.id" t-att-value="proposal.id" t-att-selected="proposal.id === state.contentStudio.proposalId">Versión <t t-esc="proposal.revision || proposal.id"/> · <t t-esc="proposal.createdAt || ''"/></option></select></header>
     <button t-if="state.contentStudio.pendingProposals" type="button" class="bpi-studio__new-proposal" t-on-click="() => this.studioSelectProposal(state.contentStudio.session.proposals[0].id)"><i aria-hidden="true" class="fa fa-check-circle"/> Hay una propuesta nueva. Abrir para revisar <i aria-hidden="true" class="fa fa-arrow-right"/></button>
     <div class="bpi-studio__preview-tabs" role="tablist" aria-label="Contenido de la propuesta"><button t-foreach="[{id:'short',label:'Corta'},{id:'long',label:'Larga'},{id:'seo',label:'SEO'},{id:'geo',label:'GEO'}]" t-as="tab" t-key="tab.id" type="button" role="tab" t-att-aria-selected="state.contentStudio.previewTab === tab.id ? 'true' : 'false'" t-on-click="() => state.contentStudio.previewTab = tab.id" t-esc="tab.label"/></div>
     <div t-if="state.contentStudio.proposalId" class="bpi-studio__preview-content">
      <div t-if="state.contentStudio.previewTab === 'short' || state.contentStudio.previewTab === 'long'" class="bpi-studio__paper"><p class="bpi-studio__hint"><t t-esc="studioPreviewWordCount()"/> palabras · Revisa la claridad, no solo la extensión.</p><t t-set="previewField" t-value="state.contentStudio.previewTab === 'short' ? 'descriptionHtml' : 'technicalDescriptionHtml'"/><StudioRichEditor sanitize="(html) => this.sanitizeDescriptionHtml(html)" value="state.contentStudio.preview[previewField]" label="'Editar propuesta de descripción'" onChange="(html) => this.studioUpdatePreview(previewField, html)"/><details class="bpi-studio__html-edit"><summary><i aria-hidden="true" class="fa fa-pencil"/> Editar el contenido de esta propuesta</summary><textarea class="bpi-textarea bpi-textarea--mono" rows="12" t-att-value="state.contentStudio.preview[previewField]" t-on-input="(ev) => this.studioUpdatePreview(previewField, ev.target.value)" aria-label="Editar HTML seguro de la propuesta"/><small>Se conserva formato de texto seguro. Las imágenes y vídeos se añaden después, en Diseño.</small></details></div>
      <div t-else="" class="bpi-studio__metadata"><label>Título<input class="bpi-input" t-att-value="state.contentStudio.preview.seoData[state.contentStudio.previewTab === 'seo' ? 'seoTitle' : 'geoTitle'] || ''" t-on-input="(ev) => state.contentStudio.preview.seoData[state.contentStudio.previewTab === 'seo' ? 'seoTitle' : 'geoTitle'] = ev.target.value"/></label><label>Descripción<textarea class="bpi-textarea" rows="5" t-att-value="state.contentStudio.preview.seoData[state.contentStudio.previewTab === 'seo' ? 'seoDescription' : 'geoDescription'] || ''" t-on-input="(ev) => state.contentStudio.preview.seoData[state.contentStudio.previewTab === 'seo' ? 'seoDescription' : 'geoDescription'] = ev.target.value"/></label><label>Palabras clave<input class="bpi-input" t-att-value="state.contentStudio.preview.seoData[state.contentStudio.previewTab === 'seo' ? 'seoKeywords' : 'geoKeywords'] || ''" t-on-input="(ev) => state.contentStudio.preview.seoData[state.contentStudio.previewTab === 'seo' ? 'seoKeywords' : 'geoKeywords'] = ev.target.value"/></label><label t-if="state.contentStudio.previewTab === 'geo'">Características<input class="bpi-input" t-model="state.contentStudio.preview.seoData.geoFeatures"/></label><p class="bpi-studio__hint">Son propuestas de metadatos, no mediciones de posicionamiento.</p></div>
      <details t-if="state.contentStudio.session.proposals.length > 1" class="bpi-studio__compare"><summary><i aria-hidden="true" class="fa fa-columns"/> Comparar con otra versión</summary><select class="bpi-input" aria-label="Versión a comparar" t-model="state.contentStudio.compareId"><option value="">Seleccionar versión</option><option t-foreach="state.contentStudio.session.proposals" t-as="old" t-key="old.id" t-att-value="old.id">Versión <t t-esc="old.revision || old.id"/></option></select><div t-if="studioCompareProposal()"><h4>Descripción corta</h4><div t-out="studioSafeHtml(studioCompareProposal().descriptionHtml)"/><h4>Descripción larga</h4><div t-out="studioSafeHtml(studioCompareProposal().technicalDescriptionHtml)"/><h4>SEO / GEO</h4><p t-esc="studioCompareProposal().seoData?.seoTitle"/><p t-esc="studioCompareProposal().seoData?.seoDescription"/><p t-esc="studioCompareProposal().seoData?.geoTitle"/><p t-esc="studioCompareProposal().seoData?.geoDescription"/></div></details>
      <aside t-if="studioCurrentProposal().warnings?.length" class="bpi-studio__private-warnings"><strong><i aria-hidden="true" class="fa fa-lock"/> Notas internas · No van a la tienda</strong><ul><li t-foreach="studioCurrentProposal().warnings" t-as="warning" t-key="warning_index" t-esc="warning.message || warning"/></ul></aside>
     </div>
     <div t-else="" class="bpi-studio__preview-empty"><i aria-hidden="true" class="fa fa-file-text-o"/><h3>Una previa, no una publicación.</h3><p>Tu propuesta aparecerá aquí cuando Nancy AI termine. Las descripciones guardadas no se modifican.</p></div>
     <aside t-if="studioCurrentProposal().stale || studioCurrentProposal().conflicts?.length" class="bpi-studio__private-warnings" role="alert">Esta versión tiene conflictos o se basa en datos anteriores. Revisa las fuentes y solicita una nueva propuesta antes de aplicarla.</aside><footer class="bpi-studio__approval"><div class="bpi-studio__apply-fields"><label t-foreach="[{id:'short',label:'Corta'},{id:'long',label:'Larga'},{id:'seo',label:'SEO'},{id:'geo',label:'GEO'}]" t-as="choice" t-key="choice.id"><input type="checkbox" t-model="state.contentStudio.selected[choice.id]"/><span t-esc="choice.label"/></label></div><label class="bpi-studio__replace"><input type="checkbox" t-model="state.contentStudio.replaceChanged"/> Confirmo reemplazar los borradores si cambiaron desde que abrí la propuesta</label><button type="button" class="bpi-button bpi-button--primary" t-att-disabled="!state.contentStudio.proposalId || state.contentStudio.busy || studioCurrentProposal().stale || studioCurrentProposal().conflicts?.length" t-on-click="studioApply"><i aria-hidden="true" class="fa fa-check"/> Aplicar a la ficha <i aria-hidden="true" class="fa fa-arrow-right"/></button><p>Solo llena borradores. Usa <b>Guardar ficha</b> para guardar contenido y SEO/GEO juntos.</p><button t-if="studioHasLocalChanges()" type="button" class="bpi-studio__discard" t-on-click="studioDiscardLocal">Descartar cambios locales del Studio</button></footer>
    </section>
   </div>
   <div t-else="" class="bpi-studio__loading"><button type="button" class="bpi-button bpi-button--primary" t-on-click="() => this.openContentStudio()">Volver a intentar</button></div>
  </section>
 </div>
</t>

<t t-name="bader_product_intelligence.DescriptionDesigner" owl="1">
 <section class="bpi-designer" aria-label="Diseño de la descripción larga">
  <header class="bpi-designer__header"><div><small>BADER DESIGN SYSTEM</small><h3>Más que palabras.</h3><p>Enriquece la descripción sin perder su texto principal.</p></div><label class="bpi-designer__enable"><input type="checkbox" t-att-checked="descriptionLayout().enabled" t-on-change="toggleDescriptionDesign"/> Mostrar diseño en la tienda</label></header>
  <p t-if="!descriptionLayout().enabled" class="bpi-studio__hint">El diseño está desactivado. La tienda seguirá mostrando únicamente la descripción larga. Tus bloques se conservan.</p>
  <div class="bpi-designer__palette"><button t-foreach="['text','image','video','columns','container','callout','divider']" t-as="kind" t-key="kind" type="button" class="bpi-button bpi-button--secondary" t-on-click="() => this.addDescriptionBlock(kind)"><i aria-hidden="true" class="fa fa-plus"/> <t t-esc="descriptionBlockLabel(kind)"/></button></div>
  <div class="bpi-designer__viewport"><span><i aria-hidden="true" class="fa fa-lock"/> Mídias privadas hasta guardar la ficha</span><div><button type="button" t-att-class="state.descriptionPreviewSize === 'desktop' ? 'is-active' : ''" aria-label="Vista de escritorio" t-on-click="() => state.descriptionPreviewSize = 'desktop'"><i aria-hidden="true" class="fa fa-desktop"/></button><button type="button" t-att-class="state.descriptionPreviewSize === 'mobile' ? 'is-active' : ''" aria-label="Vista de móvil" t-on-click="() => state.descriptionPreviewSize = 'mobile'"><i aria-hidden="true" class="fa fa-mobile"/></button><button type="button" t-on-click="loadDescriptionMedia" aria-label="Actualizar archivos privados"><i aria-hidden="true" class="fa fa-refresh"/></button></div></div>
  <p t-if="state.descriptionMediaError" class="bpi-studio__error" role="alert" t-esc="state.descriptionMediaError"/>
  <button t-if="state.descriptionMediaError &amp;&amp; !state.descriptionMediaBusy" type="button" class="bpi-button bpi-button--secondary" t-on-click="discardDescriptionUpload">Descartar carga interrumpida</button>
  <div t-if="state.descriptionUpload" class="bpi-designer__upload-progress" role="status"><strong t-esc="state.descriptionUpload.filename"/><progress max="100" t-att-value="state.descriptionUpload.percent"/><span><t t-esc="state.descriptionUpload.percent"/>% · No cierres esta ficha mientras se carga</span></div>
  <div t-att-class="'bpi-designer__canvas ' + (state.descriptionPreviewSize === 'mobile' ? 'is-mobile' : '')"><t t-foreach="descriptionLayout().blocks" t-as="block" t-key="block.id"><t t-call="bader_product_intelligence.DescriptionBlock"/></t></div>
  <p class="bpi-studio__hint">El diseño se guarda con Descripciones y FAQs. Las próximas propuestas de Nancy AI reemplazan solo el texto principal; no eliminan tus imágenes, vídeos ni bloques.</p>
 </section>
</t>

<t t-name="bader_product_intelligence.DescriptionBlock" owl="1">
 <article t-att-class="'bpi-design-block is-' + block.type + ' preset-' + (block.preset || 'white') + ' align-' + (block.align || 'left') + ' effect-' + (block.effect || 'none') + ' spacing-' + (block.spacing || 'normal')">
  <header class="bpi-design-block__toolbar"><strong><i aria-hidden="true" t-att-class="block.type === 'main' ? 'fa fa-link' : 'fa fa-square-o'"/> <t t-esc="descriptionBlockLabel(block.type)"/></strong><div><button type="button" title="Mover arriba" aria-label="Mover bloque arriba" t-on-click="() => this.moveDescriptionBlock(block.id, -1)"><i aria-hidden="true" class="fa fa-arrow-up"/></button><button type="button" title="Mover abajo" aria-label="Mover bloque abajo" t-on-click="() => this.moveDescriptionBlock(block.id, 1)"><i aria-hidden="true" class="fa fa-arrow-down"/></button><button t-if="block.type !== 'main'" type="button" title="Duplicar" aria-label="Duplicar bloque" t-on-click="() => this.duplicateDescriptionBlock(block.id)"><i aria-hidden="true" class="fa fa-clone"/></button><button t-if="block.type !== 'main'" type="button" title="Quitar bloque, sin borrar el archivo original" aria-label="Quitar bloque" t-on-click="() => this.removeDescriptionBlock(block.id)"><i aria-hidden="true" class="fa fa-trash-o"/></button></div></header>
  <div class="bpi-design-block__body">
   <t t-if="block.type === 'main'"><div class="bpi-studio__formatted" t-out="studioSafeHtml(state.contentForm.technicalDescription)"/><p class="bpi-design-block__note">Texto vinculado a la descripción larga. Edítalo en la pestaña Texto.</p></t>
   <!-- Recursive t-call does not retain ancestor loop keys for component identity. -->
   <t t-if="block.type === 'text' || block.type === 'callout'"><StudioRichEditor t-key="block.id" sanitize="(html) => this.sanitizeDescriptionHtml(html)" value="block.html || ''" label="'Texto complementario'" onChange="(html) => this.updateDescriptionBlock(block.id, 'html', html)"/></t>
   <t t-if="block.type === 'image' || block.type === 'video'">
    <img t-if="block.type === 'image' &amp;&amp; block.mediaId" t-att-src="descriptionMediaPreview(block)" t-att-alt="block.alt || ''" class="bpi-design-block__image"/>
    <div t-if="block.type === 'video'" class="bpi-description-layout"><figure class="bpi-layout__video-figure" t-att-style="descriptionVideoStyle(block)"><div class="bpi-layout__video-stage">
     <video t-if="block.mediaId" t-att-src="descriptionMediaPreview(block)" t-att-poster="block.posterMediaId ? descriptionMediaPreview({mediaId:block.posterMediaId}) : undefined" controls="controls" preload="metadata" playsinline="playsinline"/>
     <div t-else="" class="bpi-layout__play"><img t-if="block.posterMediaId" t-att-src="descriptionMediaPreview({mediaId:block.posterMediaId})" alt="Portada del vídeo"/><span class="bpi-layout__play-icon" aria-hidden="true">▶</span></div>
    </div></figure></div>
    <div t-if="block.type === 'image' &amp;&amp; !block.mediaId" class="bpi-design-block__placeholder"><i aria-hidden="true" class="fa fa-picture-o"/><span>Una imagen que cuenta más</span></div>
    <div t-if="block.type === 'video'" class="bpi-design-block__video-settings">
     <label>Ancho del vídeo · <t t-esc="block.videoWidth || 100"/> %<input type="range" min="25" max="100" step="5" t-att-value="block.videoWidth || 100" aria-label="Ancho del vídeo" t-on-input="(ev) => this.setDescriptionVideoWidth(block.id, ev.target.value)"/><small>En móvil se adapta al ancho disponible.</small></label>
     <label>Proporción<select class="bpi-input" t-att-value="block.videoRatio || 'auto'" t-on-change="(ev) => this.updateDescriptionBlock(block.id, 'videoRatio', ev.target.value)"><option value="auto" t-att-selected="!block.videoRatio || block.videoRatio === 'auto'">Automática</option><option value="16:9" t-att-selected="block.videoRatio === '16:9'">Horizontal · 16:9</option><option value="9:16" t-att-selected="block.videoRatio === '9:16'">Vertical · 9:16</option><option value="1:1" t-att-selected="block.videoRatio === '1:1'">Cuadrada · 1:1</option><option value="4:3" t-att-selected="block.videoRatio === '4:3'">Clásica · 4:3</option></select><small>MP4: dimensiones guardadas. Redes: formato habitual; puedes corregirlo.</small></label>
     <label class="bpi-studio__upload">Subir portada<input type="file" accept=".jpg,.jpeg,.png,.webp" t-att-disabled="state.descriptionMediaBusy" t-on-change="(ev) => this.uploadDescriptionMedia(ev, block.id, true)"/></label>
     <select class="bpi-input" aria-label="Portada del vídeo" t-att-value="block.posterMediaId || ''" t-on-change="(ev) => this.chooseDescriptionPoster(block.id, ev.target.value)"><option value="" t-att-selected="!block.posterMediaId">Sin portada personalizada</option><option t-foreach="state.descriptionMedia.filter(item => item.kind === 'image' &amp;&amp; item.state === 'ready')" t-as="poster" t-key="poster.id" t-att-value="poster.id" t-att-selected="poster.id === block.posterMediaId" t-esc="poster.filename"/></select>
     <button t-if="block.url" type="button" class="bpi-button bpi-button--secondary" t-att-disabled="state.descriptionMediaBusy" t-on-click="() => this.fetchDescriptionPoster(block.id)">Obtener portada de YouTube</button>
    </div>
    <div class="bpi-design-block__media-controls"><label class="bpi-studio__upload"><i aria-hidden="true" class="fa fa-cloud-upload"/> <t t-esc="block.type === 'video' ? 'Subir MP4 · hasta 200 MiB' : 'Subir imagen · hasta 10 MiB'"/><input type="file" t-att-accept="block.type === 'video' ? '.mp4' : '.jpg,.jpeg,.png,.webp'" t-att-disabled="state.descriptionMediaBusy" t-on-change="(ev) => this.uploadDescriptionMedia(ev, block.id)"/></label><select class="bpi-input" aria-label="Elegir archivo privado del producto" t-on-change="(ev) => this.chooseDescriptionMedia(block.id, ev.target.value)"><option value="">Biblioteca del producto</option><option t-foreach="state.descriptionMedia.filter(item => item.kind === block.type &amp;&amp; item.state === 'ready')" t-as="media" t-key="media.id" t-att-value="media.id" t-att-selected="media.id === block.mediaId" t-esc="media.filename"/></select></div>
    <label t-if="block.type === 'video'">O un enlace de YouTube, Instagram, TikTok o Facebook<input class="bpi-input" type="url" placeholder="https://…" t-att-value="block.url || ''" t-on-change="(ev) => this.setDescriptionVideoUrl(block.id, ev.target.value)"/><small>La portada de YouTube se obtiene al añadir el enlace. El reproductor se carga solo cuando el cliente pulsa play.</small></label>
    <label t-if="block.type === 'image'">Texto alternativo<input class="bpi-input" maxlength="500" placeholder="Describe la imagen para lectores de pantalla" t-att-value="block.alt || ''" t-on-input="(ev) => this.updateDescriptionBlock(block.id, 'alt', ev.target.value)"/></label><label>Leyenda<input class="bpi-input" maxlength="500" t-att-value="block.caption || ''" t-on-input="(ev) => this.updateDescriptionBlock(block.id, 'caption', ev.target.value)"/></label>
   </t>
   <t t-if="block.type === 'columns' || block.type === 'container'"><div t-att-class="block.type === 'columns' ? 'bpi-design-columns' : 'bpi-design-container'"><t t-foreach="block.children || []" t-as="child" t-key="child.id"><t t-call="bader_product_intelligence.DescriptionBlock"><t t-set="block" t-value="child"/></t></t></div><button t-if="block.type === 'container' &amp;&amp; block.children.length &lt; 20" type="button" class="bpi-button bpi-button--secondary" t-on-click="() => this.addDescriptionBlock('text', block.id)"><i aria-hidden="true" class="fa fa-plus"/> Añadir texto al contenedor</button></t>
   <hr t-if="block.type === 'divider'"/>
  </div>
  <footer class="bpi-design-block__settings"><label>Espacio<select t-att-value="block.spacing || 'normal'" t-on-change="(ev) => this.updateDescriptionBlock(block.id, 'spacing', ev.target.value)"><option value="compact">Compacto</option><option value="normal">Normal</option><option value="spacious">Amplio</option></select></label><label>Fondo<select t-att-value="block.preset || 'white'" t-on-change="(ev) => this.updateDescriptionBlock(block.id, 'preset', ev.target.value)"><option value="white">Blanco</option><option value="mist">Bader suave</option><option value="petrol">Azul petróleo</option><option value="lime">Verde Bader</option></select></label><label>Alineación<select t-att-value="block.align || 'left'" t-on-change="(ev) => this.updateDescriptionBlock(block.id, 'align', ev.target.value)"><option value="left">Izquierda</option><option value="center">Centro</option></select></label><label>Efecto<select t-att-value="block.effect || 'none'" t-on-change="(ev) => this.updateDescriptionBlock(block.id, 'effect', ev.target.value)"><option value="none">Sin efecto</option><option value="lift">Elevación suave</option></select></label></footer>
 </article>
</t>
<t t-name="bader_product_intelligence.StudioRichEditor" owl="1">
 <div class="bpi-studio-rich"><div class="bpi-studio-rich__tools" role="toolbar" aria-label="Formato de la propuesta"><button t-foreach="[{command:'bold',icon:'bold',label:'Negrita'},{command:'italic',icon:'italic',label:'Cursiva'},{command:'insertUnorderedList',icon:'list-ul',label:'Lista'},{command:'undo',icon:'undo',label:'Deshacer'},{command:'redo',icon:'repeat',label:'Rehacer'}]" t-as="tool" t-key="tool.command" type="button" t-att-title="tool.label" t-att-aria-label="tool.label" t-on-mousedown.prevent="() => {}" t-on-click="() => this.command(tool.command)"><i aria-hidden="true" t-att-class="'fa fa-' + tool.icon"/></button><small>Previa editable</small></div><div class="bpi-studio__formatted bpi-studio-rich__surface" t-ref="studioRichEditor" contenteditable="true" role="textbox" aria-multiline="true" t-att-aria-label="props.label" t-on-input="change" t-on-blur="blur" t-on-paste="paste" t-on-drop.prevent="() => {}"/></div>
</t>
</templates>
