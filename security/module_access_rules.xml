<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Legacy models predate delegated access. Apply company isolation to the
         new operator role without changing historical system-admin ACLs. -->
    <record id="bpi_keyword_operator_company_rule" model="ir.rule">
        <field name="name">Keywords BPI: empresas autorizadas</field>
        <field name="model_id" ref="model_bpi_product_keyword"/>
        <field name="groups" eval="[(4, ref('group_bpi_user'))]"/>
        <field name="domain_force">['|', ('product_tmpl_id.company_id', '=', False), ('product_tmpl_id.company_id', 'in', company_ids)]</field>
    </record>
