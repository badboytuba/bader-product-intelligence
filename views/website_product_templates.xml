<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bpi_product_detail_extensions" model="ir.ui.view">
        <field name="name">bader.product.intelligence.website.formatted.description</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="mode">extension</field>
        <field name="priority">90</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <!-- Website must participate in the native product cache key:
                 presentation is opt-in per website and can be switched off. -->
            <xpath expr="//t[@t-cache='pricelist,product']" position="attributes">
                <attribute name="t-cache">pricelist,product,website,bpi_variant_public and bpi_variant_public['cacheKey']</attribute>
            </xpath>
            <xpath expr="//*[@id='product_detail']" position="attributes">
                <attribute name="t-attf-class" add="#{'bpi-product-premium' if website.bpi_premium_storefront_enabled else ''}" separator=" "/>
                <attribute name="t-att-data-bpi-variant-workspace">product.id if bpi_variant_public else None</attribute>
                <attribute name="t-att-data-bpi-selected-variant">bpi_variant_public['variantId'] if bpi_variant_public else None</attribute>
                <attribute name="t-att-data-bpi-storefront-product">product.id if website.bpi_premium_storefront_enabled else None</attribute>
            </xpath>
            <xpath expr="//*[@id='product_detail']/div[hasclass('row')][1]" position="attributes">
                <attribute name="t-if">not website.bpi_premium_storefront_enabled</attribute>
            </xpath>
            <!-- The native toolbar also carries the tariff selector. Its
                 calculation must run even when the old toolbar is omitted. -->
            <xpath expr="//t[@t-call='website_sale.product_price']" position="before">
                <t t-if="website.bpi_premium_storefront_enabled">
                    <t t-set="website_sale_pricelists" t-value="website.get_pricelist_available(show_visible=True)"/>
                    <t t-set="hasPricelistDropdown" t-value="website_sale_pricelists and len(website_sale_pricelists) &gt; 1"/>
                    <div t-if="hasPricelistDropdown" class="bpi-product-pricelist">
                        <t t-call="website_sale.pricelist_list"><t t-set="_classes" t-value="'d-inline-block'"/></t>
                    </div>
                </t>
            </xpath>

            <xpath expr="//h1[@t-field='product.name']" position="before">
                <h1 t-if="bpi_variant_public" itemprop="name" class="bpi-variant-name" t-out="bpi_variant_public['name']"/>
            </xpath>
            <xpath expr="//h1[@t-field='product.name']" position="attributes">
                <attribute name="t-if">not bpi_variant_public</attribute>
            </xpath>
            <xpath expr="//div[@id='product_details']/p[@t-field='product.description_sale']" position="replace">
                <div t-if="bpi_variant_public" class="text-muted my-2 bpi-website-description bader-brand bpi-variant-short" itemprop="description" t-out="bpi_variant_public['short']"/>
                <div t-elif="product.bpi_ai_generated_description"
                     class="text-muted my-2 bpi-website-description bader-brand"
                     itemprop="description"
                     data-bpi-description="formatted"
                     t-field="product.bpi_ai_generated_description"/>
                <p t-else=""
                   class="text-muted my-2 bpi-website-description bader-brand"
                   itemprop="description"
                   placeholder="Una descripcion corta que aparecera tambien en documentos."
                   t-field="product.description_sale"/>
            </xpath>

            <xpath expr="//div[@id='product_detail_main']" position="after">
                <div t-if="bpi_variant_public" class="bpi-variant-editorial"><t t-call="bader_product_intelligence.variant_editorial"/></div>
                <section t-if="not bpi_variant_public and product.bpi_technical_description"
                         id="bpi-product-technical-description"
                         class="bpi-website-technical-description bader-brand"
                         data-bpi-technical-description="formatted"
                         aria-labelledby="bpi-product-technical-description-title">
                    <div class="bpi-website-technical-description__header">
                        <span class="bpi-website-technical-description__eyebrow">Información técnica</span>
                        <h2 id="bpi-product-technical-description-title">
                            Descripción técnica de <t t-out="product.name"/>
                        </h2>
                        <p>Especificaciones, compatibilidad y recomendaciones de uso profesional.</p>
                    </div>
                    <div class="bpi-description-host" t-att-data-bpi-variant-layout="product.id if product._bpi_has_variant_layout() else None">
                    <t t-set="bpi_layout" t-value="product._bpi_public_description_layout(website)"/>
                    <t t-if="bpi_layout" t-call="bader_product_intelligence.description_layout"/>
                    <div t-else="" class="bpi-website-technical-description__content"
                         t-field="product.bpi_technical_description"/>
                    </div>
                </section>

                <t t-set="bpi_documents" t-value="not bpi_variant_public and product._bpi_public_document_panel(website)"/>
                <section t-if="bpi_documents" class="bpi-product-documents bader-brand" aria-labelledby="bpi-documents-public-title" data-bpi-documents="public">
                    <div class="bpi-product-documents__cover">
                        <img t-if="bpi_documents['coverUrl']" t-att-src="bpi_documents['coverUrl']" t-att-alt="bpi_documents['title'] or 'Catálogos y documentación'" loading="lazy"/>
                        <div t-else="" class="bpi-product-documents__icon" aria-hidden="true"><i class="fa fa-book"/></div>
                    </div>
                    <div class="bpi-product-documents__body"><span class="bpi-documents-eyebrow">EXPLORA CADA DETALLE</span><h2 id="bpi-documents-public-title" t-out="bpi_documents['title'] or 'Catálogos y documentación'"/><p t-if="bpi_documents['intro']" t-out="bpi_documents['intro']"/>
                        <div class="bpi-product-documents__actions"><a t-foreach="bpi_documents['buttons']" t-as="bpi_document" t-att-href="bpi_document['fileUrl'] or bpi_document['url']" target="_blank" rel="noopener noreferrer" class="bpi-product-documents__button"><i t-att-class="'fa fa-file-pdf-o' if bpi_document['kind'] == 'file' else 'fa fa-book'" aria-hidden="true"/><span t-out="bpi_document['label']"/><i class="fa fa-external-link" aria-hidden="true"/><span class="sr-only"> (abre en una pestaña nueva)</span></a></div>
                    </div>
                </section>

                <section t-if="not bpi_variant_public and product.bpi_public_faqs"
                         id="bpi-product-faq"
                         class="bpi-website-faq bader-brand"
                         data-bpi-faq="public"
                         aria-labelledby="bpi-product-faq-title"
                         itemscope="itemscope"
                         itemtype="https://schema.org/FAQPage">
                    <div class="bpi-website-faq__header">
                        <span class="bpi-website-faq__eyebrow">FAQ</span>
                        <h2 id="bpi-product-faq-title">
                            Preguntas frecuentes sobre <t t-out="product.name"/>
                        </h2>
                        <p>Información útil sobre características, uso y compra.</p>
                    </div>
                    <div class="bpi-website-faq__list">
                        <details class="bpi-website-faq__item"
                                 t-foreach="product.bpi_public_faqs"
                                 t-as="bpi_faq"
                                 t-att-open="'open' if bpi_faq_index == 0 else None"
                                 itemprop="mainEntity"
                                 itemscope="itemscope"
                                 itemtype="https://schema.org/Question">
                            <summary class="bpi-website-faq__question">
                                <span itemprop="name" t-out="bpi_faq['question']"/>
                                <span class="bpi-website-faq__icon" aria-hidden="true"></span>
                            </summary>
                            <div class="bpi-website-faq__answer"
                                 itemprop="acceptedAnswer"
                                 itemscope="itemscope"
                                 itemtype="https://schema.org/Answer">
                                <p itemprop="text" t-out="bpi_faq['answer']"/>
                            </div>
                        </details>
                    </div>
                </section>
            </xpath>
        </field>
    </record>

    <!-- Website may clone website_sale.product as a website-specific primary
         view without an XML ID. Synchronize the same bridge to those copies. -->
    <function model="ir.ui.view" name="bpi_sync_product_description_bridges"/>
</odoo>
