<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bpi_product_detail_extensions" model="ir.ui.view">
        <field name="name">bader.product.intelligence.website.formatted.description</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="mode">extension</field>
        <field name="priority">90</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='product_details']/p[@t-field='product.description_sale']" position="replace">
                <div t-if="product.bpi_ai_generated_description"
                     class="text-muted my-2 bpi-website-description bader-brand"
                     itemprop="description"
                     data-bpi-description="formatted"
                     t-field="product.bpi_ai_generated_description"/>
                <p t-else=""
                   class="text-muted my-2 bpi-website-description bader-brand"
                   itemprop="description"
                   placeholder="Una descripcion corta que aparecera tambien en documentos."
                   t-field="product.description_sale"/>
            </xpath>

            <xpath expr="//div[@id='product_detail_main']" position="after">
                <section t-if="product.bpi_technical_description"
                         id="bpi-product-technical-description"
                         class="bpi-website-technical-description bader-brand"
                         data-bpi-technical-description="formatted"
                         aria-labelledby="bpi-product-technical-description-title">
                    <div class="bpi-website-technical-description__header">
                        <span class="bpi-website-technical-description__eyebrow">Información técnica</span>
                        <h2 id="bpi-product-technical-description-title">
                            Descripción técnica de <t t-out="product.name"/>
                        </h2>
                        <p>Especificaciones, compatibilidad y recomendaciones de uso profesional.</p>
                    </div>
                    <div class="bpi-website-technical-description__content"
                         t-field="product.bpi_technical_description"/>
                </section>

                <section t-if="product.bpi_public_faqs"
                         id="bpi-product-faq"
                         class="bpi-website-faq bader-brand"
                         data-bpi-faq="public"
                         aria-labelledby="bpi-product-faq-title"
                         itemscope="itemscope"
                         itemtype="https://schema.org/FAQPage">
                    <div class="bpi-website-faq__header">
                        <span class="bpi-website-faq__eyebrow">FAQ</span>
                        <h2 id="bpi-product-faq-title">
                            Preguntas frecuentes sobre <t t-out="product.name"/>
                        </h2>
                        <p>Información útil sobre características, uso y compra.</p>
                    </div>
                    <div class="bpi-website-faq__list">
                        <details class="bpi-website-faq__item"
                                 t-foreach="product.bpi_public_faqs"
                                 t-as="bpi_faq"
                                 t-att-open="'open' if bpi_faq_index == 0 else None"
                                 itemprop="mainEntity"
                                 itemscope="itemscope"
                                 itemtype="https://schema.org/Question">
                            <summary class="bpi-website-faq__question">
                                <span itemprop="name" t-out="bpi_faq['question']"/>
                                <span class="bpi-website-faq__icon" aria-hidden="true"></span>
                            </summary>
                            <div class="bpi-website-faq__answer"
                                 itemprop="acceptedAnswer"
                                 itemscope="itemscope"
                                 itemtype="https://schema.org/Answer">
                                <p itemprop="text" t-out="bpi_faq['answer']"/>
                            </div>
                        </details>
                    </div>
                </section>
            </xpath>
        </field>
    </record>

    <!-- Website may clone website_sale.product as a website-specific primary
         view without an XML ID. Synchronize the same bridge to those copies. -->
    <function model="ir.ui.view" name="bpi_sync_product_description_bridges"/>
</odoo>
