<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bpi_product_detail_extensions" model="ir.ui.view">
        <field name="name">bader.product.intelligence.website.formatted.description</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="mode">extension</field>
        <field name="priority">90</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='product_details']/p[@t-field='product.description_sale']" position="replace">
                <div t-if="product.bpi_ai_generated_description"
                     class="text-muted my-2 bpi-website-description"
                     itemprop="description"
                     data-bpi-description="formatted"
                     t-field="product.bpi_ai_generated_description"/>
                <p t-else=""
                   class="text-muted my-2"
                   itemprop="description"
                   placeholder="Una descripcion corta que aparecera tambien en documentos."
                   t-field="product.description_sale"/>
            </xpath>
        </field>
    </record>

    <!-- Website may clone website_sale.product as a website-specific primary
         view without an XML ID. Synchronize the same bridge to those copies. -->
    <function model="ir.ui.view" name="bpi_sync_product_description_bridges"/>
</odoo>
