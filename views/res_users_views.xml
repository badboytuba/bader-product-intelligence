<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_bpi_access" model="ir.ui.view">
        <field name="name">res.users.form.bpi.module.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group name="bpi_module_access" string="Producto Intelligence" groups="base.group_erp_manager">
                    <field name="in_group_%(bader_product_intelligence.group_bpi_user)d"
                           string="Acceso a Producto Intelligence"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
