<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpi_content_template_tree" model="ir.ui.view">
        <field name="name">bpi.content.template.tree</field>
        <field name="model">bpi.content.template</field>
        <field name="arch" type="xml">
            <tree string="Modelos de descripción" class="bader-brand bader-brand-view">
                <field name="name"/>
                <field name="format"/>
                <field name="revision"/>
                <field name="category_selection_ids" widget="many2many_tags"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_bpi_content_template_form" model="ir.ui.view">
        <field name="name">bpi.content.template.form</field>
        <field name="model">bpi.content.template</field>
        <field name="arch" type="xml">
            <form string="Modelo de descripción" class="bader-brand bader-brand-view">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Nombre del modelo"/></h1></div>
                    <group>
                        <group><field name="format"/><field name="revision" readonly="1"/></group>
                        <group><field name="category_selection_ids" widget="many2many_tags" options="{'no_create': True}"/></group>
                    </group>
                    <div class="alert alert-info" role="note">La categoría interna y sus descendientes seleccionan este modelo automáticamente, salvo una configuración más específica o una excepción del producto. Cambiar el modelo no regenera ni publica descripciones existentes.</div>
                    <group string="Descripción corta">
                        <field name="short_instructions" placeholder="Cómo redactar el resumen comercial..."/>
                        <field name="short_min_words"/>
                        <field name="short_max_words"/>
                    </group>
                    <group string="Descripción larga">
                        <field name="long_instructions" placeholder="Estructura y reglas para la descripción ampliada..."/>
                        <field name="long_min_words"/>
                        <field name="long_max_words"/>
                    </group>
                    <p class="text-muted">Cero significa sin límite orientativo. Las instrucciones no son evidencia técnica: nunca se deben inventar materiales, medidas, certificaciones ni garantías. Guarda el modelo y genera una propuesta explícitamente desde el producto.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bpi_content_template_search" model="ir.ui.view">
        <field name="name">bpi.content.template.search</field>
        <field name="model">bpi.content.template</field>
        <field name="arch" type="xml">
            <search><field name="name"/><filter name="archived" string="Archivados" domain="[('active', '=', False)]"/></search>
        </field>
    </record>
    <record id="action_bpi_content_template" model="ir.actions.act_window">
        <field name="name">Modelos de descripción</field>
        <field name="res_model">bpi.content.template</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="view_product_category_content_template" model="ir.ui.view">
        <field name="name">product.category.bpi.content.template</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="bpi_content_template_id" groups="base.group_system" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <menuitem id="menu_bpi_content_templates" name="Modelos de descripción" parent="menu_bpi_root" action="action_bpi_content_template" sequence="25" groups="base.group_system"/>
</odoo>
