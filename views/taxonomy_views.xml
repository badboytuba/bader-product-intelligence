<odoo>
    <record id="view_taxonomy_term_tree" model="ir.ui.view"><field name="name">bpi.taxonomy.term.tree</field><field name="model">bpi.taxonomy.term</field><field name="arch" type="xml"><tree decoration-muted="not active" decoration-warning="state == 'draft'"><field name="name"/><field name="axis"/><field name="state"/><field name="revision"/><field name="active"/></tree></field></record>
    <record id="view_taxonomy_term_form" model="ir.ui.view"><field name="name">bpi.taxonomy.term.form</field><field name="model">bpi.taxonomy.term</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Aprobar término y sinónimos" class="oe_highlight" attrs="{'invisible':[('state','=','approved')]}"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="axis"/><field name="definition"/><field name="aliases_text" placeholder="Un sinónimo exacto por línea. No incluir conceptos relacionados."/><field name="active"/><field name="revision" readonly="1"/></group><group string="Sustitución explícita"><field name="replacement_id" domain="[('axis','=',axis),('state','=','approved'),('id','!=',id)]"/><button name="action_replace" type="object" string="Sustituir vínculos y archivar" confirm="Esta acción cambia las clasificaciones que usan este término. ¿Continuar?"/></group></sheet></form></field></record>
    <record id="action_bpi_taxonomy" model="ir.actions.act_window"><field name="name">Vocabulario de clasificación</field><field name="res_model">bpi.taxonomy.term</field><field name="view_mode">tree,form</field><field name="groups_id" eval="[(4,ref('base.group_system'))]"/></record>
    <menuitem id="menu_bpi_taxonomy" name="Vocabulario de clasificación" parent="menu_bpi_root" action="action_bpi_taxonomy" sequence="30" groups="base.group_system"/>
</odoo>
